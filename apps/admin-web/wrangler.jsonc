{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gaabe-admin-demo",
  "compatibility_date": "2026-11-22",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "admindemo.techtasks.store",
      "custom_domain": true
    }
  ]
}
