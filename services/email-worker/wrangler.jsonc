{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gaabe-demo-email",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-22",
  "workers_dev": false,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "vars": {
    "EMAIL_FROM": "Gaabe Institute <noreply@mail.techtasks.store>"
  },
  // Create with `wrangler kv namespace create SUPPRESSIONS` and put the
  // returned id here before deploying the webhook/suppression behaviour.
  // Until an id is set, the binding is absent and the worker degrades to
  // "no suppression list" rather than failing (see services/email-worker/README.md).
  "kv_namespaces": [
    { "binding": "SUPPRESSIONS", "id": "REPLACE_WITH_REAL_KV_NAMESPACE_ID" }
  ]
}
